FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
ARG WITH_PDF=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg openssh-client fonts-noto-core fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
RUN python -c "import os,subprocess,sys,tomllib; p=tomllib.load(open('pyproject.toml','rb'))['project']; groups=['media','url','mcp','cpu']+(['pdf'] if os.environ.get('WITH_PDF')=='1' else []); deps=p.get('dependencies',[])+[d for g in groups for d in p['optional-dependencies'][g]]; subprocess.check_call([sys.executable,'-m','pip','install',*deps])"
RUN if [ "$WITH_PDF" = "1" ]; then python -m playwright install --with-deps chromium; fi
COPY src ./src
RUN pip install --no-deps .
WORKDIR /work
ENTRYPOINT ["please-transcribe"]
CMD ["--help"]
